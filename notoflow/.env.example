# NotoFlow — variables d'environnement
# Copier vers `.env` ou `.env.local` à la racine de `notoflow/`.

DATABASE_URL="postgresql://notoflow:notoflow@localhost:5432/notoflow_db?schema=public"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

MISTRAL_API_KEY=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email (optionnel — si absent, les liens d'invitation sont loggés dans la console)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="NotoFlow <noreply@notoflow.app>"
