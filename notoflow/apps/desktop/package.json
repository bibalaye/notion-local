{
  "name": "@notoflow/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "NotoFlow — Application desktop (Electron)",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently --kill-others \"pnpm dev:next\" \"pnpm dev:electron\"",
    "dev:next": "pnpm --filter @notoflow/web dev",
    "dev:electron": "wait-on http://localhost:3000 && tsc -p tsconfig.electron.json && electron .",
    "build": "node scripts/build-prod.js",
    "build:electron": "tsc -p tsconfig.electron.json",
    "bundle:node": "node scripts/download-node.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit",
    "lint": "echo 'No lint configured for desktop'"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "concurrently": "^9.1.2",
    "electron": "^35.3.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.notoflow.desktop",
    "productName": "NotoFlow",
    "copyright": "Copyright © 2025 NotoFlow",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "standalone-flat",
        "to": "app",
        "filter": ["**/*"]
      },
      {
        "from": "bundled-node/node.exe",
        "to": "node.exe"
      }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "assets/icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
